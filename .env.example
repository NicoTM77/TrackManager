# Server Port Configuration
PORT=3000

# Centralized Logger Settings
# Options: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Database Connection Path
# Defaults to local.db. During testing, this is automatically forced to ':memory:'
# to guarantee that development data remains completely isolated and untouched.
DATABASE_URL=local.db

# Environment Profile
NODE_ENV=development

# Speed Optimization (Parallel Scan Concurrency)
# Controls the number of parallel workers parsing files using MediaInfo during library scans.
# Sensible default is 4 workers.
CONCURRENT_SCAN_THREADS=4

